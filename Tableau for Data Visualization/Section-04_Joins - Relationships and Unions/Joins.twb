      <table>
        <view>
          <datasources>
            <datasource caption='PayPal Payments.csv+ (Multiple Connections)' name='federated.1lfh71c1q4l50g12vsb8q16cbqlt' />
          </datasources>
          <datasource-dependencies datasource='federated.1lfh71c1q4l50g12vsb8q16cbqlt'>
