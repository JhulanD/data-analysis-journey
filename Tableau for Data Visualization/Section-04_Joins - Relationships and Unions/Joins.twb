            <column caption='USD Converted Amount' datatype='real' name='[Calculation_3514617602936832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL([USD Conversion]) THEN [Amount]&#13;&#10;&#13;&#10;else [Amount] * [USD Conversion]&#13;&#10;END' />
